TEXT 104 464 Left 2 !.func gaussian_pulse(a, b, c, phase) a*exp(-square((time- b)/c)/2)*cos(2*pi*freq*(time - b)-phase)
TEXT 104 504 Left 2 !.param Cbody = 0.7089u\n.param Lbody = 158200\n.param Rbody = 4.0348K\n.param freq = 0.28201\n.param Cgap =   1.3618u\n.param Cwirebody = 0.7488u\n.param Lwire = 708593\n.param Rwire = 28.75K\n.param q = 1\n.param epsilon1 = 6.9*0.055263\n.param RTline = 6k\n.param phi = 5.3\n.param Rin = 71.8330K\n.param Cin = 49.8910u\n.param amp = 10E-12\n.param phase = 0.72*pi\n.param sigdur = 5.1\n.param Zin = 520K\n \n.func fn_v(f) 1 - f  + f*ln(f)/6\n.func get_f(E) pwr(q, 3)/(4*pi*epsilon1*pwr(phi, 2))*E\n \n.func ifn(A, a, b, phi, vc, d, g) -1E-15*A*a*square(7*g*Efield(vc*1E+12, d))/phi*exp(-b*pwr(phi, 2/3)/(7*g*Efield(vc*1E+12, d))*fn_v(get_f(7*g*Efield(vc*1E+12, d))))\n.fun Efield(v,d) abs(max(v/d, 0))\n.fun is(A, alph, T, phi, vc, d, g) -1E-15*A*alph*square(T)*exp(min((-phi +0.5*sqrt((g*Efield(vc*1E+12, d)/(d*3.14*0.055263))/(0.8617u*T)), 0)))
