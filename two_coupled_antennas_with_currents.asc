TEXT -120 392 Left 2 !.tran 0 260 120 0.007
TEXT 344 1320 Left 2 !.opt method=gear abstol=1e-16 reltol=1e-15 gmin=1e-12 Trtol=0.02
TEXT 352 1384 Left 2 !.opt chgtol=5e-18 itl1=300 itl2=450 itl4=500 itl5= 800
TEXT 352 800 Left 2 !.func fn_v(f) 1 - f  + f*ln(f)/6
TEXT 352 856 Left 2 !.func get_f(E) pwr(q, 3)/(4*pi*epsilon1*pwr(phi, 2))*E
TEXT 352 760 Left 2 !.func ifn(A, a, b, phi, vc, d, g) -1E-15*A*a*square(g*Efield(vc*1E+12, d))/phi*exp(limit(-b*pwr(phi, 3/2)/(g*Efield(vc*1E+12, d))*fn_v(get_f(g*Efield(vc*1E+12, d))), -160, 160))
TEXT 360 904 Left 2 !.func gaussian_pulse(a, b, c, freq, phase)  a*exp(-square((time- b)/c)/2)*cos(2*pi*freq*(time - b)-phase)
TEXT 352 960 Left 2 !.func Efield(v,d) abs(max(v/d, 1E-18))\n \n.func is(A, alph, T, phi, vc, d, g) -1E-15*A*alph*square(T)*exp(limit((-phi +0.5*sqrt(g*Efield(vc*1E+12, d)/(pi*epsilon0)))/(Kb*T), -160, 160))
